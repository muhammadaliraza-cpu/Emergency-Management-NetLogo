<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.4" nlw-version="2.16.1 (90be9317)">
  <code><![CDATA[
globals [
  total-evacuated
  total-casualties
  wind-dir
  wind-speed
  water-speed
]

turtles-own [
  role             ;; "person" "gov" "volunteer" "healthcare"
  status           ;; "safe" "evacuating" "casualty"
  reaction-t       ;; delay before moving
]

patches-own [
  contam-level     ;; contamination intensity
]

;; SETUP
to setup
  clear-all
  set total-evacuated 0
  set total-casualties 0
  set-default-shape turtles "person"

  ;; contamination source
  ask patches [
    set contam-level 0
    set pcolor white
  ]
  ask patch 0 0 [
    set contam-level 10
    set pcolor red
  ]

  ;; people
  create-turtles num-people [
    setxy random-xcor random-ycor
    set role "person"
    set status "safe"
    set color blue
    set reaction-t random 5
  ]

  ;; government
  create-turtles 1 [
    set role "gov"
    set color red
    set shape "house"
    setxy min-pxcor max-pycor
  ]

  ;; volunteers
  create-turtles num-volunteers [
    set role "volunteer"
    set color green
    setxy random-xcor random-ycor
  ]

  ;; healthcare providers
  create-turtles num-healthcare [
    set role "healthcare"
    set color cyan
    set shape "person"
    setxy random-xcor random-ycor
  ]

  ;; environment factors (randomized each setup)
  set wind-dir random 360
  set wind-speed 1 + random 3
  set water-speed 1 + random 2

  setup-plots   ;; reset plots (built-in primitive)
  reset-ticks
end


to go
  spread-contamination
  issue-alert
  move-people
  help-evacuate
  heal-casualties
  update-status
  record-stats
  tick
end

;; CONTAMINATION SPREAD (radial + wind/water bias)

to spread-contamination
  ask patches with [contam-level > 0] [
    ;; radial spread with water bias
    let nbrs patches in-radius (spread-rate + water-speed)
    ask nbrs with [contam-level < 50] [
      set contam-level contam-level + 1
      set pcolor scale-color red contam-level 0 50
    ]

    ;; wind-biased spread
    let wind-dx cos wind-dir
    let wind-dy sin wind-dir
    let steps wind-speed
    foreach (range 1 (steps + 1)) [ s ->
      let tx round (s * wind-dx)
      let ty round (s * wind-dy)
      let downwind patch-at tx ty
      if downwind != nobody [
        ask downwind [
          if contam-level < 50 [
            set contam-level contam-level + 1
            set pcolor scale-color red contam-level 0 50
          ]
        ]
      ]
    ]
  ]
end



to issue-alert
  ask turtles with [role = "gov"] [
    if ticks = 5 [
      ask turtles with [role = "person"] [
        set reaction-t max list 0 (reaction-t - 3)
      ]
    ]
  ]
end


to move-people
  ask turtles with [role = "person"] [
    if status = "safe" [
      if [contam-level] of patch-here > 2 and reaction-t <= 0 [
        set status "evacuating"
        set color yellow
      ]
      set reaction-t reaction-t - 1
    ]

    if status = "evacuating" [
      fd 1
      rt random 20 - random 20
      ;; boundary = safe zone
      if pxcor = max-pxcor or pxcor = min-pxcor or
         pycor = max-pycor or pycor = min-pycor [
        set status "safe"
        set color blue
        set total-evacuated total-evacuated + 1
      ]
    ]
  ]
end


to help-evacuate
  ask turtles with [role = "volunteer"] [
    let nearby turtles with [role = "person" and status = "evacuating" and distance myself < 2]
    ask nearby [
      fd 2
      set color green + 2
    ]
  ]
end


to heal-casualties
  ask turtles with [role = "healthcare"] [
    let near-cas turtles with [role = "person" and status = "casualty" and distance myself < 2]
    ask near-cas [
      set status "safe"
      set color cyan
      set total-casualties total-casualties - 1
      set total-evacuated total-evacuated + 1
    ]
  ]
end


to update-status
  ask turtles with [role = "person" and status != "casualty"] [
    if [contam-level] of patch-here > 20 [
      set status "casualty"
      set color gray
      set total-casualties total-casualties + 1
    ]
  ]
end


to record-stats
  set-current-plot "Evacuation vs Casualties"
  plotxy ticks total-evacuated
  plotxy ticks total-casualties
end]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="true" y="10" frameRate="30" minPycor="-16" height="438" showTickCounter="true" patchSize="13" fontSize="10" wrappingAllowedY="true" width="437" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"/>
    <button x="72" y="92" height="33" disableUntilTicks="false" forever="false" kind="Observer" width="63" sizeVersion="0">setup</button>
    <button x="97" y="174" height="33" disableUntilTicks="false" forever="true" kind="Observer" width="63" sizeVersion="0">go</button>
    <slider x="719" step="1" y="73" max="500" display="num-people" height="33" min="50" direction="Horizontal" default="199" variable="num-people" width="172" sizeVersion="0"/>
    <slider x="750" step="1" y="155" max="20" display="num-volunteers" height="33" min="0" direction="Horizontal" default="5" variable="num-volunteers" width="172" sizeVersion="0"/>
    <slider x="802" step="1" y="260" max="5" display="spread-rate" height="33" min="1" direction="Horizontal" default="2" variable="spread-rate" width="172" sizeVersion="0"/>
    <monitor x="742" precision="17" y="324" height="45" fontSize="11" width="102" sizeVersion="0">total-evacuated</monitor>
    <monitor x="743" precision="17" y="419" height="45" fontSize="11" width="101" sizeVersion="0">total-casualties</monitor>
    <plot x="1014" autoPlotX="true" yMax="10" autoPlotY="true" yAxis="Count of People" y="112" xMin="0" height="150" legend="false" xMax="10" yMin="0" xAxis="Ticks" display="Evacuation vs Casualties" width="200" sizeVersion="0">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="default" color="-16777216" legend="true">
        <setup/>
        <update>plot count turtles</update>
      </pen>
    </plot>
    <slider x="764" step="1" y="218" max="20" display="num-healthcare" height="33" min="0" direction="Horizontal" default="3" variable="num-healthcare" width="172" sizeVersion="0"/>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

This is an agent-based simulation of an emergency water contamination event. It demonstrates how contamination spreads outward from a source, influenced by environmental factors (wind, water flow), and how different actors (government, volunteers, healthcare providers, and the general public) respond. The model illustrates both the dynamics of contamination and the effectiveness of interventions in reducing casualties and increasing evacuations.

## HOW IT WORKS

Contamination Dynamics: Contamination originates at the center and spreads radially, with additional directional bias from wind and water currents. Patches change color intensity based on contamination concentration.

People (blue → yellow → gray): Begin safe (blue). When contamination levels rise, they start evacuating (yellow). If exposed to high levels for too long, they become casualties (gray).

Government (red house): Issues alerts after a delay, reducing people’s reaction times to encourage faster evacuation.

Volunteers (green): Help nearby evacuees by increasing their evacuation speed.

Healthcare providers (cyan): Rescue nearby casualties, converting them back to safety.
## HOW TO USE IT

Press setup to initialize the environment.

Press go to start the simulation.

Adjust sliders before setup:

num-people: number of general public agents.

num-volunteers: number of volunteer helpers.

num-healthcare: number of healthcare workers.

spread-rate: base rate of contamination spread.

Monitors:

total-evacuated: number of people who reached safe zones.

total-casualties: number of people incapacitated.

Plot: Evacuation vs Casualties shows trends over time.)



## THINGS TO TRY

How quickly contamination spreads outward and intensifies.

The delay before people start evacuating (reaction time) and how the government alert reduces this delay.

The influence of volunteers on evacuation speed.

The effectiveness of healthcare workers in reducing casualties.

The trade-off between total evacuations and casualties across time.


## CREDITS AND REFERENCES
Model inspired by: Xi, H., & Chan, F. T. S. (2018). Research and applications of agent-based modeling for China’s emergency management: A review. Proceedings of the 2018 Winter Simulation Conference.

Implementation: Muhammad Ali Raza (2025) in NetLogo 6.x.]]></info>
